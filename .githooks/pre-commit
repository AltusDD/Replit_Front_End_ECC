#!/usr/bin/env bash
set -euo pipefail

blocked_patterns=(
  '^\.local/'
  '\\.bin$'
  '^proofpacks/'
  '_PROOF_PACK_'
  '_TRUTH_PACK_'
  '\\.curl\\.txt$'
  '_headers\\.txt$'
  '_body\\.json$'
  '_raw\\.txt$'
)

staged="$(git diff --cached --name-only)"

for p in "${blocked_patterns[@]}"; do
  if echo "$staged" | grep -E "$p" >/dev/null 2>&1; then
    echo "BLOCKED: staging matches forbidden pattern: $p"
    echo "$staged"
    exit 1
  fi
done

exit 0
